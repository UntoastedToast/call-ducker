# Maintainer: UntoastedToast <45534729+UntoastedToast@users.noreply.github.com>
pkgname=call-ducker
pkgver=0.1.1
pkgrel=1
pkgdesc='Adjust game audio automatically during calls'
arch=('x86_64')
url='https://github.com/UntoastedToast/call-ducker'
license=('GPL-3.0-or-later')
depends=('glib2' 'gtk4' 'libadwaita' 'json-glib' 'libpulse')
# dbus, pulseaudio and xorg-server-xvfb belong in makedepends rather than
# checkdepends: -Dintegration_tests=enabled makes them a configure-time
# requirement inside build(), and makepkg --nocheck does not install checkdepends.
makedepends=('meson' 'ninja' 'vala' 'gettext' 'desktop-file-utils' 'appstream'
             'dbus' 'pulseaudio' 'xorg-server-xvfb')
optdepends=('pipewire-pulse: PipeWire PulseAudio compatibility server')
source=("$pkgname-$pkgver.tar.xz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build -Dintegration_tests=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
